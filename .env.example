# Travel Expense Policy Assistant - Environment Configuration Template
# Copy this file to .env to configure optional cloud LLM providers.
# If no .env file or credentials are provided, the system runs in high-reliability 'local' mode.

# Active Provider: 'local' (default, zero credentials), 'openrouter', or 'openai'
LLM_PROVIDER=local

# OpenRouter Configuration (Optional - Compatible with free open-source models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

