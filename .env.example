# Travel Expense Policy Assistant - Environment Configuration Template
# Copy this file to .env to configure optional cloud LLM providers.
# If no .env file or credentials are provided, the system runs in high-reliability 'local' mode.

# Active Provider: 'local' (default, zero credentials), 'openrouter', 'azure_openai', or 'openai'
LLM_PROVIDER=local

# OpenRouter Configuration (Optional - Compatible with free open-source models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI Configuration (Optional - Enterprise Microsoft AI Stack)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview
